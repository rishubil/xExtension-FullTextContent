				</tr>
				<tr>
					<th><?= $t('defuddle_latest_known') ?></th>
					<td><?= $latestDefuddle !== null ? $esc($latestDefuddle) : '—' ?></td>
				</tr>
				<tr>
					<th><?= $t('defuddle_last_check') ?></th>
					<td><?= $lastCheck !== null ? date('Y-m-d H:i:s', $lastCheck) : $t('defuddle_never_checked') ?></td>
				</tr>
			</tbody>
		</table>
		</div>

		<div class="ftc-maintenance">
			<form method="post" action="<?= $configureUrl ?>">
				<input type="hidden" name="_csrf" value="<?= $esc($csrf) ?>" />
				<input type="hidden" name="fulltextcontent_action" value="update_defuddle" />
				<button type="submit" class="btn"><?= $t('update_defuddle') ?></button>
			</form>
			<form method="post" action="<?= $configureUrl ?>">
				<input type="hidden" name="_csrf" value="<?= $esc($csrf) ?>" />
				<input type="hidden" name="fulltextcontent_action" value="redownload_obscura" />
				<button type="submit" class="btn"><?= $t('redownload_obscura') ?></button>
