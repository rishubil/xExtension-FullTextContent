			</div>

			<div class="form-group">
				<label for="obscura_stealth_build">
					<input type="checkbox" id="obscura_stealth_build" name="obscura_stealth_build" value="1"
						<?= $obscuraStealthBuild ? 'checked' : '' ?> />
					<?= $t('obscura_stealth_build') ?>
				</label>
				<p class="help-block"><?= $t('obscura_stealth_build_help') ?></p>
			</div>

			<details class="ftc-advanced">
				<summary><?= $t('advanced') ?></summary>

				<div class="form-group">
					<label for="defuddle_version"><?= $t('defuddle_version') ?></label>
					<input type="text" id="defuddle_version" name="defuddle_version"
						value="<?= $esc($defuddleVersion) ?>" placeholder="latest" />
