				</div>

				<div class="form-group">
					<label for="defuddle_check_interval"><?= $t('defuddle_check_interval') ?></label>
					<input type="number" id="defuddle_check_interval" name="defuddle_check_interval"
						value="<?= (int) $checkInterval ?>" min="1" />
					<p class="help-block"><?= $t('defuddle_check_interval_help') ?></p>
				</div>

