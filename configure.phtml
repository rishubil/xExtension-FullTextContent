					<p class="help-block"><?= $t('obscura_download_url_help') ?></p>
				</div>

				<div class="form-group">
					<label for="obscura_binary"><?= $t('obscura_binary') ?></label>
					<input type="text" id="obscura_binary" name="obscura_binary"
						value="<?= $esc($obscuraBinaryOverride) ?>" placeholder="<?= $esc($obscuraBinPath) ?>" />
					<p class="help-block"><?= $t('obscura_binary_help') ?></p>
				</div>
			</details>

			<button type="submit" class="btn btn-important"><?= $t('save') ?></button>
		</section>
	</form>

	<hr />

	<section>
		<h2><?= $t('status') ?></h2>

		<div class="ftc-table-scroll">
		<table class="table">
			<tbody>
				<tr>
					<th><?= $t('obscura_status') ?></th>
					<td>
						<?php if ($obscuraDownloaded): ?>
							<code><?= $esc($obscuraEffectivePath) ?></code>
						<?php else: ?>
							<em><?= $t('obscura_not_downloaded') ?></em>
						<?php endif; ?>
					</td>
				</tr>
				<tr>
					<th><?= $t('obscura_build') ?></th>
					<td><?php
						if ($obscuraBinaryOverride !== '') {
							echo '<em>' . $t('build_override') . '</em>';
						} elseif ($installedBuild !== null) {
							echo $t('build_' . $installedBuild);
						} else {
							echo '<em>' . $t('obscura_not_downloaded') . '</em>';
