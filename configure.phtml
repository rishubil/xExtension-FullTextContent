<?php
/** @var FullTextContentExtension $this */

$defuddleManager = $this->buildDefuddleManager();
$binaryResolver  = $this->buildBinaryResolver();

$installedDefuddle  = $defuddleManager->installedVersion();
$latestDefuddle     = $defuddleManager->latestKnownVersion();
$lastCheck          = $defuddleManager->lastCheckTimestamp();
$obscuraBinPath     = $binaryResolver->binaryPath();

$nodeBinary           = $this->getUserConfigurationString('node_binary') ?? 'node';
$obscuraDownloadUrl   = $this->getUserConfigurationString('obscura_download_url') ?? '';
$obscuraBinaryOverride = $this->getUserConfigurationString('obscura_binary') ?? '';
$defuddleVersion      = $defuddleManager->configuredVersion();
$checkInterval        = $this->getUserConfigurationInt('defuddle_check_interval') ?? 168;
$fetchTimeout         = $this->getUserConfigurationInt('fetch_timeout') ?? 30;
$allowPrivateNetwork  = $this->getUserConfigurationBool('allow_private_network') ?? false;
$obscuraStealthBuild  = $this->getUserConfigurationBool('obscura_stealth_build') ?? false;

$feedDao   = FreshRSS_Factory::createFeedDao();
$allFeeds  = $feedDao->listFeeds();

// The binary the pipeline actually runs: the override when set, else the download.
$obscuraEffectivePath = $obscuraBinaryOverride !== '' ? $obscuraBinaryOverride : $obscuraBinPath;
$obscuraDownloaded    = is_executable($obscuraEffectivePath);
$obscuraVersion       = BinaryResolver::probeVersion($obscuraEffectivePath);

$versionWarnings = [];
if ($obscuraDownloaded && !VersionRequirements::meets($obscuraVersion, VersionRequirements::OBSCURA_MIN)) {
	$versionWarnings[] = _t('ext.fulltextcontent.config.warn_obscura_old',
		VersionRequirements::parse($obscuraVersion) ?? _t('ext.fulltextcontent.config.version_unknown'), VersionRequirements::OBSCURA_MIN);
}
if ($installedDefuddle !== null && !VersionRequirements::meets($installedDefuddle, VersionRequirements::DEFUDDLE_MIN)) {
	$versionWarnings[] = _t('ext.fulltextcontent.config.warn_defuddle_installed_old',
		$installedDefuddle, VersionRequirements::DEFUDDLE_MIN);
}
// Build selection (standard / stealth) only applies to the downloaded binary.
$installedBuild = $obscuraBinaryOverride === '' ? $binaryResolver->installedBuild() : null;
$buildWarnings = [];
if ($obscuraBinaryOverride === '' && $obscuraStealthBuild && !$binaryResolver->canSelectBuild()) {
	$buildWarnings[] = _t('ext.fulltextcontent.config.warn_build_no_variant');
} elseif ($installedBuild !== null && $installedBuild !== $binaryResolver->wantedBuild()) {
	$buildWarnings[] = _t('ext.fulltextcontent.config.warn_build_mismatch',
		_t('ext.fulltextcontent.config.build_' . $installedBuild),
		_t('ext.fulltextcontent.config.build_' . $binaryResolver->wantedBuild()));
}
$stealthFeedCount = 0;
foreach ($allFeeds as $feed) {
	if ($feed->attributeBoolean('fulltextcontent_stealth')) {
		$stealthFeedCount++;
	}
}
$standardBuildInUse = $obscuraBinaryOverride === '' && ($installedBuild ?? $binaryResolver->wantedBuild()) === 'standard';
$stealthWarning = $stealthFeedCount > 0 && $standardBuildInUse
	? _t('ext.fulltextcontent.config.warn_stealth_standard_build', $stealthFeedCount)
	: null;

if (VersionRequirements::isOlder($defuddleVersion, VersionRequirements::DEFUDDLE_MIN)) {
	$versionWarnings[] = _t('ext.fulltextcontent.config.warn_defuddle_pinned_old',
		$defuddleVersion, VersionRequirements::DEFUDDLE_MIN);
}


$categories = [];
foreach ($allFeeds as $feed) {
	$catName = $feed->category() ? $feed->category()->name() : _t('gen.short.without_category');
	$categories[$catName][] = $feed;
}
ksort($categories);

$esc = static fn($value): string => htmlspecialchars((string) $value, ENT_QUOTES);
$t   = static fn(string $key, ...$args): string => _t('ext.fulltextcontent.config.' . $key, ...$args);

// "" is obscura's default (load); the others are offered with what they mean.
$waitUntilOptions = [
	''                 => $t('wait_until_load'),
	'domcontentloaded' => $t('wait_until_domcontentloaded'),
	'networkidle0'     => $t('wait_until_networkidle0'),
];
$summaryStrings = [
	'default'                => $t('summary_default'),
	'selector'               => $t('summary_selector'),
	'wait'                   => $t('summary_wait'),
	'timeout'                => $t('summary_timeout'),
	'stealth'                => $t('summary_stealth'),
	'wait_until_domcontentloaded' => $t('summary_wait_until_domcontentloaded'),
	'wait_until_networkidle0'     => $t('summary_wait_until_networkidle0'),
];
$jsStrings = $summaryStrings + [
	'test_running' => $t('test_running'),
	'test_ok'      => $t('test_ok'),
	'test_failed'  => $t('test_failed'),
];

/** Short description of the options a feed overrides (mirrored in script.js). */
$summarize = static function (int $wait, string $waitUntil, string $selector, bool $stealth, int $timeout) use ($summaryStrings): string {
	$parts = [];
	if ($selector !== '') {
		$parts[] = sprintf($summaryStrings['selector'], $selector);
	}
	if ($wait > 0) {
		$parts[] = sprintf($summaryStrings['wait'], $wait);
	}
	if (isset($summaryStrings['wait_until_' . $waitUntil])) {
		$parts[] = $summaryStrings['wait_until_' . $waitUntil];
	}
	if ($timeout > 0) {
		$parts[] = sprintf($summaryStrings['timeout'], $timeout);
	}
	if ($stealth) {
		$parts[] = $summaryStrings['stealth'];
	}
	return $parts === [] ? $summaryStrings['default'] : implode(' · ', $parts);
};

// Usually only a few feeds need full text: list those first and keep the
// others, grouped by category, in a collapsible picker.
$enabledFeeds = [];
$otherFeeds = [];
foreach ($categories as $catName => $feeds) {
	foreach ($feeds as $feed) {
		if ($feed->attributeBoolean('fulltextcontent_enabled')) {
			$enabledFeeds[] = $feed;
		} else {
			$otherFeeds[$catName][] = $feed;
		}
	}
}

/** Renders one feed list item; used for both the enabled and the other feeds. */
$renderFeed = static function (FreshRSS_Feed $feed) use ($esc, $t, $summarize, $waitUntilOptions, $fetchTimeout): void {
	$fid       = (int) $feed->id();
	$enabled   = (bool) $feed->attributeBoolean('fulltextcontent_enabled');
	$wait      = (int) ($feed->attributeInt('fulltextcontent_wait') ?? 0);
	$waitUntil = (string) ($feed->attributeString('fulltextcontent_wait_until') ?? '');
	$selector  = (string) ($feed->attributeString('fulltextcontent_selector') ?? '');
	$stealth   = (bool) ($feed->attributeBoolean('fulltextcontent_stealth') ?? false);
	$timeout   = (int) ($feed->attributeInt('fulltextcontent_timeout') ?? 0);
	$website   = $feed->website();
	?>
	<li class="ftc-feed<?= $enabled ? ' ftc-enabled' : '' ?>" data-feed-id="<?= $fid ?>">
		<div class="ftc-feed-head">
			<label class="ftc-feed-toggle" for="feed_<?= $fid ?>">
				<input type="checkbox" class="ftc-feed-enabled"
					name="fulltextcontent_feeds[]" id="feed_<?= $fid ?>" value="<?= $fid ?>"
					<?= $enabled ? 'checked' : '' ?> />
				<img class="favicon" src="<?= $esc($feed->favicon()) ?>" alt="" loading="lazy" />
				<span class="ftc-feed-name"><?= $feed->name() ?></span>
			</label>
			<?php if ($website !== ''): ?>
				<a class="ftc-feed-site" href="<?= $esc($website) ?>" target="_blank" rel="noreferrer"
					title="<?= $t('open_website') ?>"><?= $t('open_website') ?> ↗</a>
			<?php endif; ?>
		</div>
		<details class="ftc-feed-options">
			<summary>
				<span class="ftc-options-label"><?= $t('fetch_options') ?>:</span>
				<span class="ftc-feed-summary"><?= $esc($summarize($wait, $waitUntil, $selector, $stealth, $timeout)) ?></span>
			</summary>
			<div class="ftc-options-panel">
				<div class="ftc-option">
					<label for="ftc_selector_<?= $fid ?>"><?= $t('opt_selector') ?></label>
					<input type="text" id="ftc_selector_<?= $fid ?>" data-ftc-opt="selector"
						name="fulltextcontent_selector[<?= $fid ?>]" value="<?= $esc($selector) ?>"
						placeholder="<?= $t('opt_selector_placeholder') ?>"
						aria-describedby="ftc_selector_<?= $fid ?>_help" />
					<p class="ftc-help" id="ftc_selector_<?= $fid ?>_help"><?= $t('opt_selector_help') ?></p>
				</div>
				<div class="ftc-option">
					<label for="ftc_wait_<?= $fid ?>"><?= $t('opt_wait') ?></label>
					<input type="number" id="ftc_wait_<?= $fid ?>" data-ftc-opt="wait" min="1"
						name="fulltextcontent_wait[<?= $fid ?>]" value="<?= $wait > 0 ? $wait : '' ?>"
						placeholder="<?= $t('opt_wait_placeholder') ?>"
						aria-describedby="ftc_wait_<?= $fid ?>_help" />
					<p class="ftc-help" id="ftc_wait_<?= $fid ?>_help"><?= $t('opt_wait_help') ?></p>
				</div>
				<div class="ftc-option">
					<label for="ftc_wait_until_<?= $fid ?>"><?= $t('opt_wait_until') ?></label>
					<select id="ftc_wait_until_<?= $fid ?>" data-ftc-opt="wait_until"
						name="fulltextcontent_wait_until[<?= $fid ?>]"
						aria-describedby="ftc_wait_until_<?= $fid ?>_help">
						<?php foreach ($waitUntilOptions as $value => $label): ?>
							<option value="<?= $value ?>" <?= $waitUntil === $value ? 'selected' : '' ?>><?= $esc($label) ?></option>
						<?php endforeach; ?>
					</select>
					<p class="ftc-help" id="ftc_wait_until_<?= $fid ?>_help"><?= $t('opt_wait_until_help') ?></p>
				</div>
				<div class="ftc-option">
					<label for="ftc_timeout_<?= $fid ?>"><?= $t('opt_timeout') ?></label>
					<input type="number" id="ftc_timeout_<?= $fid ?>" data-ftc-opt="timeout" min="1"
						name="fulltextcontent_timeout[<?= $fid ?>]" value="<?= $timeout > 0 ? $timeout : '' ?>"
						placeholder="30"
						aria-describedby="ftc_timeout_<?= $fid ?>_help" />
					<p class="ftc-help" id="ftc_timeout_<?= $fid ?>_help"><?= $t('opt_timeout_help', $fetchTimeout) ?></p>
				</div>
				<div class="ftc-option ftc-option-wide">
					<label for="ftc_stealth_<?= $fid ?>" class="ftc-checkbox-label">
						<input type="checkbox" id="ftc_stealth_<?= $fid ?>" data-ftc-opt="stealth"
							name="fulltextcontent_stealth[]" value="<?= $fid ?>" <?= $stealth ? 'checked' : '' ?>
							aria-describedby="ftc_stealth_<?= $fid ?>_help" />
						<?= $t('opt_stealth') ?>
					</label>
					<p class="ftc-help" id="ftc_stealth_<?= $fid ?>_help"><?= $t('opt_stealth_help') ?></p>
				</div>
			</div>
			<div class="ftc-test">
				<p class="ftc-test-title"><?= $t('test_title') ?></p>
				<div class="ftc-test-controls">
					<input type="url" class="ftc-test-url" aria-label="<?= $t('test_url') ?>"
						placeholder="<?= $t('test_url_placeholder') ?>" />
					<button type="button" class="btn ftc-test-btn"><?= $t('test_button') ?></button>
				</div>
				<p class="ftc-help"><?= $t('test_help') ?></p>
				<div class="ftc-test-result" aria-live="polite" hidden></div>
			</div>
		</details>
	</li>
	<?php
};

$configureUrl = _url('extension', 'configure', 'e', urlencode($this->getName()));
$csrf = FreshRSS_Auth::csrfToken();
?>

<div class="extension-configure ftc-configure">

	<?php foreach ($versionWarnings as $warning): ?>
		<p class="alert alert-warn ftc-version-warning"><?= $esc($warning) ?></p>
	<?php endforeach; ?>
	<?php foreach ($buildWarnings as $warning): ?>
		<p class="alert alert-warn ftc-build-warning"><?= $esc($warning) ?></p>
	<?php endforeach; ?>
	<?php if ($stealthWarning !== null): ?>
		<p class="alert alert-warn ftc-stealth-warning"><?= $esc($stealthWarning) ?></p>
	<?php endif; ?>

	<section class="ftc-feeds"
		data-preview-url="<?= _url('fullTextContent', 'preview') ?>"
		data-csrf="<?= $esc($csrf) ?>"
		data-strings="<?= $esc(json_encode($jsStrings)) ?>">
		<h2><?= $t('feeds') ?></h2>
		<p><?= $t('feeds_help') ?></p>

		<?php if ($allFeeds === []): ?>
			<p><?= $t('no_feeds') ?></p>
		<?php else: ?>
		<form method="post" action="<?= $configureUrl ?>" class="ftc-feed-form">
			<input type="hidden" name="_csrf" value="<?= $esc($csrf) ?>" />
			<input type="hidden" name="fulltextcontent_action" value="save_feeds" />

			<h3 class="ftc-enabled-heading">
				<?= $t('enabled_feeds') ?> <span class="ftc-enabled-count"><?= count($enabledFeeds) ?></span>
			</h3>
			<p class="ftc-no-enabled"<?= $enabledFeeds !== [] ? ' hidden' : '' ?>><?= $t('no_enabled_feeds') ?></p>
			<ul class="ftc-feed-list ftc-enabled-list">
				<?php foreach ($enabledFeeds as $feed) { $renderFeed($feed); } ?>
			</ul>

			<details class="ftc-add-panel"<?= $enabledFeeds === [] ? ' open' : '' ?>>
				<summary>
					<?= $t('add_feeds') ?> <span class="ftc-add-count"><?= count($allFeeds) - count($enabledFeeds) ?></span>
				</summary>
				<p class="ftc-help"><?= $t('add_feeds_help') ?></p>
				<input type="search" class="ftc-feed-filter" aria-label="<?= $t('filter_feeds') ?>"
					placeholder="<?= $t('filter_feeds') ?>…" />
				<p class="ftc-no-match" hidden><?= $t('no_match') ?></p>
				<div class="ftc-add-list">
					<?php foreach ($otherFeeds as $catName => $feeds): ?>
						<div class="ftc-category">
							<h4 class="ftc-category-name"><?= $esc($catName) ?></h4>
							<ul class="ftc-feed-list">
								<?php foreach ($feeds as $feed) { $renderFeed($feed); } ?>
							</ul>
						</div>
					<?php endforeach; ?>
				</div>
			</details>

			<div class="ftc-savebar">
				<button type="submit" class="btn btn-important"><?= $t('save_feeds') ?></button>
				<span class="ftc-dirty-note" hidden><?= $t('unsaved_changes') ?></span>
			</div>
		</form>
		<?php endif; ?>
	</section>

	<hr />

	<form method="post" action="<?= $configureUrl ?>">
		<input type="hidden" name="_csrf" value="<?= $esc($csrf) ?>" />
		<input type="hidden" name="fulltextcontent_action" value="save_global" />

		<section>
			<h2><?= $t('global') ?></h2>

			<div class="form-group">
				<label for="fetch_timeout"><?= $t('fetch_timeout') ?></label>
				<input type="number" id="fetch_timeout" name="fetch_timeout"
					value="<?= (int) $fetchTimeout ?>" min="5" />
				<p class="help-block"><?= $t('fetch_timeout_help') ?></p>
			</div>

			<div class="form-group">
				<label for="allow_private_network">
					<input type="checkbox" id="allow_private_network" name="allow_private_network" value="1"
						<?= $allowPrivateNetwork ? 'checked' : '' ?> />
					<?= $t('allow_private_network') ?>
				</label>
